# ==============================================================================
# TỆP CẤU HÌNH MẪU CHO ỨNG DỤNG ONG NHỎ
# Sao chép tệp này thành .env và điền các khóa cấu hình của bạn:
#   copy .env.example .env
# ==============================================================================

# Cổng khởi chạy máy chủ (Mặc định: 3000)
PORT=3000

# URL gốc của ứng dụng (Dùng cho domain chính thức hoặc ngrok/cloudflare tunnel)
# Ví dụ: http://localhost:3000 hoặc https://ongnho.vn
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# CẤU HÌNH GOOGLE SEARCH CONSOLE (OAUTH 2.0)
# Lấy tại: https://console.cloud.google.com/apis/credentials
# Lưu ý: Thêm Redirect URI vào Google Cloud Console:
#        http://localhost:3000/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# (Tùy chọn) Định nghĩa cụ thể URI chuyển hướng nếu không dùng theo APP_URL
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------------------
# CẤU HÌNH KHÓA AI CHO TÍNH NĂNG NHẬN XÉT THÔNG MINH
# ------------------------------------------------------------------------------
# Khóa OpenAI API (dành cho tóm tắt & phân tích chiến lược SEO)
OPENAI_API_KEY=your_openai_api_key_here

# Khóa Gemini API (nếu sử dụng Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
